<Project Sdk="Microsoft.NET.Sdk">
  <!-- NextraAxisVM add-on: loads inside AxisVM (AddOns folder) and publishes the running application in the
       COM Running Object Table so the NextraAxisVM tools (PyAxisVM) can work on the model the user has open. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NextraAxisVM</AssemblyName>
    <RootNamespace>NextraAxisVM</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\</OutputPath>
    <DebugType>none</DebugType>
    <NoWarn>CS1591;CS0618</NoWarn>
    <!-- Where AxisVM is installed: only the add-on interface DLL is referenced from it (not copied). -->
    <AxisVMDir Condition="'$(AxisVMDir)' == ''">C:\AXISVM X8</AxisVMDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AxisVMDotNetAddonPluginInterface_v1.0.FW4">
      <HintPath>$(AxisVMDir)\AxisVMDotNetAddonPluginInterface_v1.0.FW4.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.AxisVM.FW4">
      <HintPath>$(AxisVMDir)\Interop.AxisVM.FW4.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
